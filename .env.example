# --- Enclave runtime -------------------------------------------------------

# Set to 1 only for local development; the verifier rejects mock tokens unless
# it is explicitly configured to allow them.
SIXFIGS_MOCK_ATTESTATION=0

# Return deterministic balances instead of calling RPCs. Local dev only.
SIXFIGS_DEV_INSECURE_BALANCES=0

# Enclave HTTP server
PORT=8080
HOST=0.0.0.0

# CORS origin allowed to call the enclave (the 6figs web app). `*` is honored
# for testing only; production pins the exact frontend origin.
SIXFIGS_ALLOWED_ORIGIN=https://6figs.xyz

# Set to 1 only when the VM firewall restricts :8080 to the GFE proxy ranges
# (130.211.0.0/22, 35.191.0.0/16) and an external GCP load balancer fronts the
# enclave. Uses the client IP the balancer appends to X-Forwarded-For for rate
# limiting instead of the balancer's socket address.
SIXFIGS_TRUST_PROXY=0

# --- Portfolio data sources ------------------------------------------------

# JSON-RPC endpoints. One per chain, from Alchemy/Infura/QuickNode/etc.
# The RPC provider can see the queried addresses; that is the accepted tradeoff.
SIXFIGS_RPC_ETHEREUM=
SIXFIGS_RPC_BASE=
SIXFIGS_RPC_ARBITRUM=
SIXFIGS_RPC_OPTIMISM=
SIXFIGS_RPC_POLYGON=
SIXFIGS_RPC_SOLANA=

# Optional redundant providers (same *_SECONDARY suffix per chain above).
# When set, value-critical reads must agree within 0.1% or the request fails.
# SIXFIGS_RPC_ETHEREUM_SECONDARY=
# SIXFIGS_RPC_SOLANA_SECONDARY=

# 64-hex secret for keyed nullifiers. REQUIRED in production (the enclave
# refuses to boot without it) unless a KMS-wrapped nullifier key is configured
# below; omit only for local development.
# SIXFIGS_NULLIFIER_KEY=

# --- KMS-bound secrets (production) ----------------------------------------
# When SIXFIGS_KMS_KEY is set the escrow key is unwrapped at boot through the
# attested workload identity; setting SIXFIGS_KMS_WRAPPED_NULLIFIER_KEY moves
# the nullifier key out of the environment as well. See docs/INTEGRATION.md.
# SIXFIGS_KMS_KEY=
# SIXFIGS_KMS_WRAPPED_ESCROW_KEY=
# SIXFIGS_KMS_WRAPPED_NULLIFIER_KEY=
# SIXFIGS_KMS_STS_AUDIENCE=

# Optional CoinGecko demo API key to raise rate limits. Without it, public
# limits apply and unpriceable tokens are skipped rather than failing the run.
COINGECKO_API_KEY=

# Price cache TTL (ms). Default 120000.
SIXFIGS_PRICE_TTL_MS=120000

# --- Confidential Space / GCP ----------------------------------------------

# Populated automatically inside the VM by the operator; used for reporting.
SIXFIGS_GCP_PROJECT=
SIXFIGS_GCP_ZONE=
SIXFIGS_GCP_INSTANCE=

# --- Deployment (scripts only) ---------------------------------------------

SIXFIGS_WORKLOAD_PROJECT=your-workload-author-project
SIXFIGS_ARTIFACT_REPOSITORY=sixfigs
SIXFIGS_IMAGE_NAME=enclave
SIXFIGS_IMAGE_TAG=latest
SIXFIGS_VM_PROJECT=your-workload-operator-project
SIXFIGS_VM_ZONE=us-central1-a
SIXFIGS_VM_NAME=sixfigs-enclave-1
SIXFIGS_SERVICE_ACCOUNT=sixfigs-enclave@your-project.iam.gserviceaccount.com
SIXFIGS_CONFIDENTIAL_COMPUTE_TYPE=SEV
SIXFIGS_MACHINE_TYPE=n2d-standard-2
SIXFIGS_IMAGE_FAMILY=confidential-space

# HTTPS load balancer (scripts/create-lb.sh). SIXFIGS_LB_HOSTNAME is the
# hostname the managed certificate is issued for.
SIXFIGS_LB_HOSTNAME=tee.6figs.xyz
SIXFIGS_LB_NAME=sixfigs-enclave-lb