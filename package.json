{
  "name": "@sixfigs/tee",
  "version": "0.1.0",
  "private": true,
  "description": "6figs TEE-based portfolio verification: Confidential Space workload, attestation verifier, and client SDK.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "files": ["dist"],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./verifier": {
      "types": "./dist/verifier/index.d.ts",
      "default": "./dist/verifier/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"test/**/*.test.ts\"",
    "server": "node --experimental-strip-types src/enclave/server.ts",
    "dev": "SIXFIGS_MOCK_ATTESTATION=1 SIXFIGS_DEV_INSECURE_BALANCES=1 node --experimental-strip-types src/enclave/server.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}